{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "aicodeverse.com" }],
      "destination": "https://app.aicodeverse.com/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.aicodeverse.com" }],
      "destination": "https://app.aicodeverse.com/",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    }
  ],
  "buildCommand": "rm -rf node_modules .vite dist && npm install && npm run build"
}